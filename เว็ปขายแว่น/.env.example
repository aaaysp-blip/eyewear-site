# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงจาก Supabase Dashboard
# Settings > API (https://app.supabase.com/project/_/settings/api)

# Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key (ลับมาก ห้าม commit / ห้ามใช้ฝั่ง browser เด็ดขาด — ใช้ได้เฉพาะใน api/*.js ที่รันบนเซิร์ฟเวอร์เท่านั้น)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
